# توکن بازوی اصلی که از @botfather بله گرفتی
BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# دیتابیس: برای اجرای محلی همین SQLite کافیه. روی سرور به PostgreSQL تغییر می‌کنه.
DATABASE_URL=sqlite+aiosqlite:///./uploadfly.db

# کلید رمزنگاری توکن ربات فروشنده‌ها. با این دستور بساز و هرگز عوضش نکن:
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=PUT_GENERATED_KEY_HERE

# Mini App: روی سرور آدرس ثابت HTTPS رو اینجا بذار. روی مک خالی بذار تا تونل موقت ساخته بشه.
WEBAPP_URL=
WEBAPP_PORT=8080

# آیدی عددی تلگرام مدیران UploadFly (با کاما جدا کن). دستورهای اضطراری: /takedown /ban /unban /stats
ADMIN_IDS=

# بازپرداخت خودکار قبل از دیدن محتوا: فقط وقتی با کیف پول واقعی بله آزمایش و تأیید شد روشن کن (REFUNDS=1).
# خاموش (پیش‌فرض): خریدار بعد از پرداخت محتوا را مستقیم می‌گیرد
REFUNDS=

# پشتیبانی (در Mini App ← پروفایل ← پشتیبانی و دستور /support): یوزرنیم حساب تلگرام پشتیبانی بدون @، و ایمیل
SUPPORT_USERNAME=
SUPPORT_EMAIL=

# --- فقط روی سرور (Docker) ---
# رمز دیتابیس: یک رمز طولانی تصادفی (مثلاً با: openssl rand -hex 24)
POSTGRES_PASSWORD=
# آدرس Mini App بدون https:// ، مثلاً app.uploadfly.com . اگر دامنه نداری: IP سرور با خط تیره + .sslip.io
DOMAIN=
# دامنه‌ی سایت معرفی (برای گوگل) بدون https:// ، مثلاً uploadfly.com
SITE_DOMAIN=
# کد تأیید Google Search Console (اختیاری، بعد از ثبت سایت در گوگل)
GOOGLE_SITE_VERIFICATION=
# یوزرنیم ربات اصلی (برای دکمه‌های سایت)
MAIN_BOT=Uploadfly_Bot
