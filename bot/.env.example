# UploadFly برای بله: نمونه‌ی تنظیمات. این فایل را به اسم .env کپی کن و مقدارها را پر کن. .env هرگز به گیت نمی‌رود.

# توکن بازوی اصلی که از @botfather بله گرفتی
BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# دیتابیس: برای اجرا روی کامپیوتر خودت همین SQLite کافیه. روی سرور Docker خودش PostgreSQL را تنظیم می‌کند.
DATABASE_URL=sqlite+aiosqlite:///./uploadfly.db

# کلید رمزنگاری توکن بازو و کیف پول فروشنده‌ها. با این دستور بساز و هرگز عوضش نکن:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=PUT_GENERATED_KEY_HERE

# Mini App: روی سرور لازم نیست (Docker از DOMAIN می‌سازد). روی کامپیوتر خودت خالی بگذار؛ اگر cloudflared نصب باشد
# یک آدرس موقت ساخته می‌شود، وگرنه Mini App فقط در مرورگر همین کامپیوتر (http://127.0.0.1:8080) باز می‌شود.
WEBAPP_URL=
WEBAPP_PORT=8080

# شناسه‌ی عددی حساب بله‌ی مدیران UploadFly (با کاما جدا کن). دستورها: /stats /reports /suspend /takedown /ban /srclink
ADMIN_IDS=

# بازپرداخت خودکار قبل از دیدن محتوا: فقط وقتی با کیف پول واقعی بله آزمایش و تأیید شد روشن کن (REFUNDS=1).
# خاموش (پیش‌فرض): خریدار بعد از پرداخت محتوا را مستقیم می‌گیرد و برگشت پول با توافق فروشنده است
REFUNDS=

# توکن آزمایشی بله (WALLET-TEST-…) پولی جابه‌جا نمی‌کند. فقط برای آزمایش روی کامپیوتر خودت روشنش کن (=1)؛
# روی سرور واقعی خالی بماند تا هیچ فروشگاهی با آن «فروش بی‌پول» نکند
ALLOW_TEST_WALLET=

# واحد قیمت‌ها به تومان (حداقل قیمت و گام دکمه‌های قیمت). عوضش نکن مگر بدانی چه می‌کنی.
PRICE_UNIT=1000

# پشتیبانی (در Mini App ← پروفایل ← پشتیبانی و دستور /support): نام کاربری حساب بله‌ی پشتیبانی بدون @، و ایمیل
SUPPORT_USERNAME=
SUPPORT_EMAIL=

# --- فقط روی سرور (Docker) ---
# رمز دیتابیس: یک رمز طولانی تصادفی (مثلاً با: openssl rand -hex 24)
POSTGRES_PASSWORD=
# آدرس Mini App بدون https:// ، مثلاً app.example.ir
DOMAIN=
# دامنه‌ی سایت معرفی (برای گوگل) بدون https:// ، مثلاً example.ir
SITE_DOMAIN=
# کد تأیید Google Search Console (اختیاری، بعد از ثبت سایت در گوگل)
GOOGLE_SITE_VERIFICATION=
# نام کاربری بازوی اصلی بدون @ (برای دکمه‌های سایت)
MAIN_BOT=uploadflybot
